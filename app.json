{
  "expo": {
    "name": "FleetDrive",
    "slug": "fleet-drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./client/assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./client/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myapp"
    },
    "android": {
      "package": "com.myapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./client/assets/images/android-icon-foreground.png",
        "backgroundImage": "./client/assets/images/android-icon-background.png",
        "monochromeImage": "./client/assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./client/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./client/app"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
